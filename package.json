{
  "name": "email-auth",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Stateless email sign-in for Effect HttpApi servers, with a Foldkit sign-in UI",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:ui": "bun --bun playwright test",
    "lint": "oxlint . && ts-lint-effect",
    "release": "git add -A && git commit -m v$npm_package_version && git tag v$npm_package_version && git push origin main v$npm_package_version"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.1.1",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.4",
    "effect": "4.1.1",
    "foldkit": "0.170.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "ts-lint": "github:laroccacharly/ts-lint#v0.6.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "effect": "^4.1.1",
    "foldkit": "^0.170.0"
  }
}
